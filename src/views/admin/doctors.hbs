<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Doctors</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
  {{> nav}}
  <main class="container py-4">
    <h1 class="h3 mb-4">Doctors</h1>
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h2 class="h5">Add doctor</h2>
            <form method="post" action="/admin/doctors" class="vstack gap-2">
              <select name="userId" class="form-select" required>
                <option value="">Select user</option>
                {{#each users}}
                  <option value="{{_id}}">{{fullName}} ({{email}})</option>
                {{/each}}
              </select>
              <select name="departmentId" class="form-select" required>
                <option value="">Select department</option>
                {{#each departments}}
                  <option value="{{_id}}">{{name}}</option>
                {{/each}}
              </select>
              <input name="specialization" class="form-control" placeholder="Specialization" required />
              <input name="experience" class="form-control" placeholder="Experience" />
              <input name="roomNumber" class="form-control" placeholder="Room number" />
              <button class="btn btn-primary">Save</button>
            </form>
          </div>
        </div>
      </div>
      <div class="col-lg-8">
        <div class="card shadow-sm">
          <div class="card-body">
            <ul class="list-group">
              {{#each doctors}}
                <li class="list-group-item">
                  <strong>{{userId.fullName}}</strong> - {{specialization}} / {{departmentId.name}}
                </li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
