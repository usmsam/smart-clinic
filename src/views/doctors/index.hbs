<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Doctors</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
  {{> nav}}
  <main class="container py-4">
    <h1 class="h3 mb-4">Doctors</h1>
    <div class="row g-3">
      {{#each doctors}}
        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body">
              <h5 class="card-title">{{userId.fullName}}</h5>
              <p class="mb-1"><strong>Specialization:</strong> {{specialization}}</p>
              <p class="mb-1"><strong>Department:</strong> {{departmentId.name}}</p>
              <p class="mb-0"><strong>Room:</strong> {{roomNumber}}</p>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  </main>
</body>
</html>
