<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Schedule</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
  {{> nav}}
  <main class="container py-4">
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h1 class="h5">Add schedule</h1>
            {{#if doctor}}
              <p class="text-muted small mb-3">Doctor: {{doctor.userId.fullName}} / {{doctor.specialization}}</p>
            {{/if}}
            <form method="post" action="/doctor/schedule" class="vstack gap-2">
              <input name="workDay" class="form-control" placeholder="Monday" />
              <input name="startTime" class="form-control" placeholder="09:00" />
              <input name="endTime" class="form-control" placeholder="17:00" />
              <select name="isActive" class="form-select">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
              </select>
              <button class="btn btn-primary">Save</button>
            </form>
          </div>
        </div>
      </div>
      <div class="col-lg-8">
        <div class="card shadow-sm">
          <div class="card-body">
            <h2 class="h5 mb-3">Existing schedules</h2>
            {{#unless schedules.length}}
              <div class="alert alert-warning mb-0">No schedules found for this doctor.</div>
            {{/unless}}
            <ul class="list-group">
              {{#each schedules}}
                <li class="list-group-item">
                  <div class="d-flex justify-content-between align-items-center">
                    <strong>{{workDay}}</strong>
                    <span>{{startTime}} - {{endTime}}</span>
                  </div>
                  {{#if slots.length}}
                    <div class="d-flex flex-wrap gap-2 mt-2">
                      {{#each slots}}
                        <span class="badge text-bg-primary">{{this}}</span>
                      {{/each}}
                    </div>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
