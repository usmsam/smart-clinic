<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Doctor Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
  {{> nav}}
  <main class="container py-4">
    <div class="alert alert-secondary">
      {{#if doctor}}
        Doctor profile loaded for {{doctor.userId.fullName}}
      {{else}}
        Doctor profile not found yet.
      {{/if}}
    </div>
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h2 class="h5">Profile</h2>
            <p class="mb-1"><strong>Specialization:</strong> {{doctor.specialization}}</p>
            <p class="mb-1"><strong>Department:</strong> {{doctor.departmentId.name}}</p>
            <p class="mb-0"><strong>Room:</strong> {{doctor.roomNumber}}</p>
            <div class="mt-3 d-flex gap-2 flex-wrap">
              <a href="/doctor/schedule" class="btn btn-primary">Manage schedule</a>
              <a href="/doctor/appointments" class="btn btn-outline-primary">Appointments</a>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h2 class="h5 mb-3">Active schedules</h2>
            {{#unless schedules.length}}
              <div class="alert alert-warning mb-0">No active schedules yet.</div>
            {{/unless}}
            <ul class="list-group">
              {{#each schedules}}
                <li class="list-group-item">
                  <div class="d-flex justify-content-between">
                    <strong>{{workDay}}</strong>
                    <span>{{startTime}} - {{endTime}}</span>
                  </div>
                </li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h2 class="h5 mb-3">Recent appointments</h2>
            {{#unless appointments.length}}
              <div class="alert alert-warning mb-0">No appointments yet.</div>
            {{/unless}}
            <ul class="list-group">
              {{#each appointments}}
                <li class="list-group-item">
                  <div class="fw-semibold">{{patientId.fullName}}</div>
                  <div class="small">{{appointmentDate}} | {{timeSlot}}</div>
                  <div class="small text-muted">Status: {{status}}</div>
                </li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
