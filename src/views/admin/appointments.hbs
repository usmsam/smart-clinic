<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Appointments</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
  {{> nav}}
  <main class="container py-4">
    <h1 class="h3 mb-4">Appointments</h1>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr><th>Patient</th><th>Doctor</th><th>Slot</th><th>Status</th></tr>
        </thead>
        <tbody>
          {{#each appointments}}
            <tr>
              <td>{{patientId.fullName}}</td>
              <td>{{doctorId.userId.fullName}}</td>
              <td>{{scheduleId.workDay}} {{scheduleId.startTime}}-{{scheduleId.endTime}}</td>
              <td>{{status}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
