<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
  {{> nav}}
  <main class="container py-4">
    <div class="alert alert-dark shadow-sm">Admin dashboard: {{user.fullName}}</div>
    <div class="row g-3">
      <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
          <h5 class="card-title">Users</h5>
          <a href="/admin/users" class="btn btn-sm btn-primary">Open</a>
        </div></div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
          <h5 class="card-title">Doctors</h5>
          <a href="/admin/doctors" class="btn btn-sm btn-primary">Open</a>
        </div></div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
          <h5 class="card-title">Departments</h5>
          <a href="/admin/departments" class="btn btn-sm btn-primary">Open</a>
        </div></div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
          <h5 class="card-title">Appointments</h5>
          <a href="/admin/appointments" class="btn btn-sm btn-primary">Open</a>
        </div></div>
      </div>
    </div>
  </main>
</body>
</html>
