<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Doctor Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
  {{> nav}}
  <main class="container py-4">
    <div class="alert alert-success shadow-sm">Doctor dashboard: {{user.fullName}}</div>
    <div class="row g-3">
      <div class="col-md-6">
        <div class="card shadow-sm h-100"><div class="card-body">
          <h5 class="card-title">Schedule</h5>
          <p class="card-text">Manage working hours and active shifts.</p>
          <a href="/doctor/schedule" class="btn btn-sm btn-primary">Open</a>
        </div></div>
      </div>
      <div class="col-md-6">
        <div class="card shadow-sm h-100"><div class="card-body">
          <h5 class="card-title">Appointments</h5>
          <p class="card-text">Review and update patient appointments.</p>
          <a href="/doctor/appointments" class="btn btn-sm btn-primary">Open</a>
        </div></div>
      </div>
    </div>
  </main>
</body>
</html>
