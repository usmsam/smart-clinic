<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Appointments</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
  {{> nav}}
  <main class="container py-4">
    <h1 class="h3 mb-4">My appointments</h1>
    <div class="row g-3">
      {{#each appointments}}
        <div class="col-md-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <h5 class="card-title">{{doctorId.userId.fullName}}</h5>
              <p class="mb-1">{{scheduleId.workDay}} | {{scheduleId.startTime}}-{{scheduleId.endTime}}</p>
              <p class="mb-3">Status: {{status}}</p>
              <form method="post" action="/appointments/{{_id}}/cancel">
                <button class="btn btn-outline-danger btn-sm">Cancel</button>
              </form>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  </main>
</body>
</html>
